# URL base del backend Laravel. No incluir una barra final.
VITE_API_BASE_URL=
# En producción lo define despliegue/instalar.ps1 (http://<balanceador>/api).
# Para desarrollo contra el sistema compartido: http://100.102.99.114/api

# Citas en tiempo real (Laravel Reverb, pasa por el balanceador en /app/).
# Vacío = la web funciona igual, sin avisos en vivo.
VITE_REVERB_APP_KEY=
# Por defecto, el mismo host desde el que se abre la web (el balanceador).
VITE_REVERB_HOST=
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
