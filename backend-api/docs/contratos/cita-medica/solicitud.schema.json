{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proyect_clinico/contratos/cita-medica/solicitud",
  "title": "Registrar cita médica – solicitud",
  "description": "POST /api/agenda/cita-medica (rol doctora). Enviar codigo_paciente O nombre_reserva, nunca ambos.",
  "type": "object",
  "properties": {
    "codigo_paciente": { "type": ["string", "null"], "maxLength": 20, "description": "Código del paciente registrado" },
    "nombre_reserva": { "type": ["string", "null"], "maxLength": 255, "description": "Nombre de quien reserva sin estar registrado" },
    "fecha": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Fecha de la cita YYYY-MM-DD" },
    "hora_inicio": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Hora de inicio HH:MM (24 h)" },
    "hora_fin": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Hora de fin HH:MM, posterior a hora_inicio" },
    "descripcion": { "type": ["string", "null"], "maxLength": 1000, "description": "Motivo u observación" }
  },
  "required": ["fecha", "hora_inicio", "hora_fin"],
  "oneOf": [
    { "required": ["codigo_paciente"], "properties": { "codigo_paciente": { "type": "string", "minLength": 1 }, "nombre_reserva": { "type": "null" } } },
    { "required": ["nombre_reserva"], "properties": { "nombre_reserva": { "type": "string", "minLength": 1 }, "codigo_paciente": { "type": "null" } } }
  ],
  "examples": [{ "codigo_paciente": "001", "fecha": "2026-11-20", "hora_inicio": "10:00", "hora_fin": "10:30", "descripcion": "Control de ortodoncia" }]
}
